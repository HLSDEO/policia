[Unit]
Description=analyser (/%I) -- checagem periodica de versao nova

[Timer]
# 4x ao dia, com folga aleatoria para varias instalacoes nao baterem no mesmo minuto.
# Persistent: se a maquina estava desligada na hora, roda ao ligar.
OnCalendar=*-*-* 00/6:17:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
