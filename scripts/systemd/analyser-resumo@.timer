[Unit]
Description=analyser (/%I) -- resumo noturno por inquerito (madrugada)

[Timer]
# Madrugada, com folga aleatoria para varias instalacoes nao baterem no mesmo minuto.
# Persistent: se a maquina estava desligada na hora, roda ao ligar.
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
