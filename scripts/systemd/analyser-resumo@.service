[Unit]
Description=analyser (/%I) -- resumo noturno por inquerito
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Roda como root: precisa de docker compose. /%I e o caminho da instalacao
# (ver comentario no analyser-update-check@.path).
Environment=ANALYSER_DIR=/%I
ExecStart=/usr/local/bin/analyser-resumo
Nice=15
TimeoutStartSec=7200
