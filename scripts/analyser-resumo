#!/usr/bin/env bash
#
# analyser-resumo — passe noturno do resumo por inquérito.
#
#   analyser-resumo                  processa todos os inquéritos com extração concluída
#   analyser-resumo --inquerito 101  só um inquérito (piloto / teste)
#   analyser-resumo --forcar         regenera mesmo sem mudança
#   analyser-resumo --dry-run        lista o que seria processado, sem chamar a IA
#
# OPCIONAL desde que o agendador passou para dentro da API (api/funcoes/agendador.py): a thread
# que sobe com o container já roda o passe às 02:00, igual em Windows e em Linux, sem nada
# instalado no host. Este script continua valendo para rodar na mão e para quem prefere o
# systemd (scripts/systemd/analyser-resumo@.service) — os dois não se atropelam, porque um passe
# completo rodado por aqui é registrado como a execução do dia e a thread não repete.
# Para ficar SÓ com o agendador do host: RESUMO_NOTURNO_AGENDADOR=0 no .env.
# Ver docs/resumo_noturno.md.
#
set -euo pipefail

INSTALL_DIR="${ANALYSER_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$INSTALL_DIR"

exec docker compose exec -T api-1 python /app/tools/resumo_noturno.py "$@"
