# Postgres do Analyser para o OpenShift.
#
# A imagem oficial registry.redhat.io/rhel9/postgresql-16 JÁ TRAZ o pacote `pgvector`
# (INSTALLED_PKGS no Dockerfile upstream do sclorg) + pg_trgm/fuzzystrmatch/pgcrypto
# (postgresql-contrib) e já é desenhada para OpenShift (UID arbitrário, nss_wrapper,
# fix-permissions). Esta imagem só acrescenta:
#  - o conteúdo de db/ (init + migracoes + import) em /opt/postgresql-init;
#  - o hook db/bootstrap/openshift_postgresql_start.sh em
#    /opt/app-root/src/postgresql-start/, que o entrypoint source no primeiro boot
#    (aplica db/init em ordem numérica e registra o baseline de db/migracoes).
#
# Confere a presença do pgvector no build: se o tag base for antigo demais, o build
# falha aqui — não no primeiro CREATE EXTENSION em produção.
# Base padrao = imagem Red Hat suportada (exige `docker login registry.redhat.io`).
# Para validar localmente sem conta Red Hat:
#   docker build -f Dockerfile.postgres \
#     --build-arg POSTGRES_BASE=quay.io/sclorg/postgresql-16-c9s \
#     -t analyser-postgres:test .
# (a imagem comunitaria sclorg e identica em scripts/entrypoint e pacotes, incl. pgvector).
ARG POSTGRES_BASE=registry.redhat.io/rhel9/postgresql-16
FROM ${POSTGRES_BASE}

USER root

COPY db /opt/postgresql-init/db
COPY db/bootstrap/openshift_postgresql_start.sh \
     /opt/app-root/src/postgresql-start/10-analyser-schema.sh

RUN test -f /usr/share/pgsql/extension/vector.control \
    || test -f /usr/share/postgresql/extension/vector.control \
    || (echo "ERRO: esta tag de rhel9/postgresql-16 nao tem pgvector; use uma tag atual" >&2; exit 1) \
    && sed -i 's/\r$//' /opt/app-root/src/postgresql-start/10-analyser-schema.sh \
                        /opt/postgresql-init/db/bootstrap/*.sh \
    && chown -R 26:0 /opt/postgresql-init /opt/app-root/src/postgresql-start \
    && chmod -R a+rX /opt/postgresql-init \
    && chmod 0750 /opt/app-root/src/postgresql-start/10-analyser-schema.sh

USER 26
