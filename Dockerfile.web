# Front-end (web/) + nginx para o OpenShift.
# nginx-unprivileged: escuta 8080, usuário não-root — o padrão que já estava validado
# no openshift.yaml de teste. Os estáticos (~30 MB de web/) não cabem em ConfigMap
# (limite ~1,5 MB do etcd), por isso viram COPY na imagem.
# O OpenShift roda com UID arbitrário (grupo root): /var/cache/nginx — onde o nginx
# não-root escreve proxy_temp, client_body e o cache do /osm-tiles/ — precisa ser
# group-writable.
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine

USER root
RUN mkdir -p /var/cache/nginx/osm-tiles \
    && chown -R 101:0 /var/cache/nginx \
    && chmod -R g+rwX /var/cache/nginx

COPY nginx/openshift.conf /etc/nginx/conf.d/default.conf
COPY web/ /usr/share/nginx/html/
# estáticos: leitura para qualquer UID
RUN chgrp -R 0 /usr/share/nginx/html && chmod -R g+rX /usr/share/nginx/html

USER 101

EXPOSE 8080
