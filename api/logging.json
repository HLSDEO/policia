{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "funcoes.logging_config.JsonFormatter"
    }
  },
  "handlers": {
    "default": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stdout"
    },
    "arquivo_erros": {
      "()": "funcoes.logging_config.handler_erros"
    }
  },
  "root": {
    "handlers": ["default", "arquivo_erros"],
    "level": "INFO"
  },
  "loggers": {
    "uvicorn": {"handlers": ["default", "arquivo_erros"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["default", "arquivo_erros"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["default"], "level": "INFO", "propagate": false}
  }
}
